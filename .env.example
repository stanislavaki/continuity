# ElevenLabs credentials for scripts/generate_narration.py
# Copy this file to ".env" (which is git-ignored) and fill in your key.
# The key is used ONLY by the local generation script — it is never shipped to
# the browser. The page loads the pre-rendered .mp3 files, not the API.

# Required. Get it from https://elevenlabs.io  ->  Profile -> API Keys
ELEVENLABS_API_KEY=

# Voice to narrate with. Run `python3 scripts/generate_narration.py --list-voices`
# to see the voices on your account, then paste the voice_id here.
ELEVENLABS_VOICE_ID=

# Optional. Defaults to eleven_multilingual_v2 (handles the German/Italian names
# in the text well). Other options: eleven_turbo_v2_5 (faster, cheaper).
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
